# Supabase — crie um projeto gratuito em https://supabase.com e copie os valores em
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente Nacional NFS-e (emissão real de nota fiscal) — "restrita" é o
# ambiente de testes sem valor fiscal, use-o sempre primeiro; só mude pra
# "producao" depois de validar manualmente um ciclo completo em restrita.
NFSE_AMBIENTE=restrita
# Certificado e-CNPJ A1 (.pfx) em base64, e a senha dele. NUNCA preencha
# estes dois valores aqui nem comite o .pfx — configure como variáveis
# "Sensitive" direto no painel da Vercel. Base64 local (PowerShell):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("caminho\para\o.pfx"))
NFSE_CERTIFICADO_PFX_BASE64=
NFSE_CERTIFICADO_SENHA=
# Segunda trava explícita — com NFSE_AMBIENTE=producao sozinho a transmissão
# real ainda é recusada; só liga de verdade com "true" aqui também, e só
# depois de validar um ciclo completo em restrita.
NFSE_PERMITIR_PRODUCAO=
